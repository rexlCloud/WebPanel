APP_NAME=rexlCloud
APP_ENV=local
# Generate with: php artisan key:generate --show
# (or in Docker: docker compose run --rm --entrypoint php panel artisan key:generate --show)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Docker Compose only
PANEL_PORT=8080
# Used by docker-compose.proxy.yml
VIRTUAL_HOST=web.rexlcloud.de

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The panel keeps no database; sessions and cache live in storage/
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"
